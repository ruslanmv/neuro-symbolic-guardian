# Production Environment Configuration
# Copy this file to .env and fill in your values

# Environment
AEGIS_ENV=production

# Policy Configuration
AEGIS_POLICY_PATH=./policies/production.yaml

# LLM Configuration
AEGIS_ENABLE_LLM=true
AEGIS_LLM_BASE_URL=https://api.openai.com/v1
AEGIS_LLM_API_KEY=your-api-key-here
AEGIS_LLM_MODEL=gpt-4o-mini

# Logging
AEGIS_LOG_LEVEL=INFO

# Security
AEGIS_FAIL_MODE=closed  # closed = deny on uncertainty, open = allow on uncertainty

# Timeouts (milliseconds)
AEGIS_SOLVER_TIMEOUT=100
AEGIS_LLM_TIMEOUT=5000

# Monitoring (optional)
PROMETHEUS_ENABLED=true
GRAFANA_PASSWORD=change-me-in-production
